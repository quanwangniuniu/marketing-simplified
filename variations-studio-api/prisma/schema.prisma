// Maps existing Django tables. Do NOT run `prisma migrate` against this database.
// Generate the client only: `npx prisma generate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdCopyVariation {
  id            BigInt    @id @default(autoincrement())
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(6)
  isDeleted     Boolean   @map("is_deleted")
  sourceMode    String    @map("source_mode") @db.VarChar(32)
  sourceRef     String    @map("source_ref")
  hook          String
  headline      String
  description   String
  cta           String    @db.VarChar(64)
  instruction   String
  modelName     String    @map("model_name") @db.VarChar(64)
  promptVersion String    @map("prompt_version") @db.VarChar(32)
  batchId       String?   @map("batch_id") @db.Uuid
  batchPosition Int?      @map("batch_position")
  status        String    @db.VarChar(20)
  createdById   BigInt?   @map("created_by_id")
  creativeId    BigInt?   @map("creative_id")
  projectId     BigInt?   @map("project_id")
  slug          String    @unique @db.VarChar(255)

  @@map("ad_copy_variation_adcopyvariation")
}

// core_project and core_projectmember are deliberately NOT modelled here.
// They are tenant-scoped (one copy per org schema) and Prisma hardcodes the
// datasource schema into its SQL, so a model here would always read `public`.
// Reach them through lib/projects.ts raw SQL instead.

model MetaAdAccount {
  id        BigInt  @id
  projectId BigInt? @map("project_id")

  @@map("meta_ad_accounts")
}

model MetaAdCreative {
  id                 BigInt @id
  adAccountId        BigInt @map("ad_account_id")
  title              String
  body               String
  callToActionType   String @map("call_to_action_type") @db.VarChar(64)

  @@map("meta_ad_creatives")
}

// Shared public-schema tables. Look these up BEFORE SET LOCAL search_path.
model Organization {
  id       BigInt  @id
  slug     String  @db.VarChar(200)
  isActive Boolean @map("is_active")

  @@map("core_organization")
}

model CustomUser {
  id                    BigInt  @id
  isActive              Boolean @map("is_active")
  currentOrganizationId BigInt? @map("current_organization_id")
  organizationId        BigInt? @map("organization_id")

  @@map("core_customuser")
}
